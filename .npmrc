# pnpm 布局说明
#
# 用 hoisted（扁平）布局而不是默认的 symlink 布局：
# 在这个项目路径下，symlink 布局导入 electron-winstaller 时会一直报
# ERR_PNPM_EPERM（rename ..._tmp_xxx -> electron-winstaller），
# 干净目录却能装上，怀疑是长路径 + 中文目录名 + 杀软扫描叠加导致的。
# 扁平布局直接拷贝文件，绕开那套 tmp+rename 导入流程，装得干净。
node-linker=hoisted

# electron-winstaller 的构建脚本用不到（那是 Squirrel 打包器才用的），
# pnpm 会因为"有脚本被忽略"而返回非 0，连带 pnpm run / typecheck 都被拖挂。
# 关掉跑脚本前的依赖状态检查，避免它每次都去跑一遍 install。
verify-deps-before-run=false
